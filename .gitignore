# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# نسخ APK جاهزة للنشر — تُرفَع كأصول (assets) ضمن GitHub Release عبر
# gh release create، ولا داعٍ لتتبّعها في git نفسه (حجمها كبير وتتغيّر
# مع كل إصدار).
/mada-v*.apk
